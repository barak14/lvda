# kbuild artifacts
*.o
*.ko
*.mod
*.mod.c
.*.cmd
*.symvers
*.order
.tmp_versions/
modules.order
Module.symvers

# clangd compilation database (machine-specific: absolute KDIR paths) + cache
compile_commands.json
.cache/

# host / userspace test + tool binaries (compiled; sources are *.c)
/tests/host/test_edid
/tests/userspace/add_remove
/tests/userspace/pool_cap
/tests/userspace/fd_reap
/tests/userspace/version
/tests/userspace/edid_bytes
/tests/userspace/debugfs_monitors
/tests/userspace/modifier_negotiation
/tests/userspace/kmsgrab_roundtrip
/tests/userspace/displayid_mode
/tests/userspace/connector_caps
/tests/userspace/cursor_plane
/tools/lvda-ctl/lvda-ctl

# packaging build artifacts (generated by per-distro builders)
/packaging/arch/*.tar.gz
/packaging/arch/*.pkg.tar.*
/packaging/arch/pkg/
/packaging/arch/src/
/packaging/debian/*.deb
/packaging/debian/*.changes
/packaging/debian/*.buildinfo
/packaging/debian/*.dsc
/packaging/rpm/*.rpm

# nix flake
/result
/result-*
/.direnv/

# local module signing keys
/MOK.der
/MOK.pem
/MOK.priv
/module/MOK.der
/module/MOK.pem
/module/MOK.priv
